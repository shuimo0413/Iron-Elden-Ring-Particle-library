APP_NAME=粒子工坊
APP_ENV=dev
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
LOG_LEVEL=INFO

# 存储（相对路径按 backend/ 目录解析，与启动目录无关）
DATABASE_URL=sqlite+aiosqlite:///./data/app.sqlite
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
DB_AUTO_CREATE=true
DATA_DIR=./data
# 粒子库根目录（含 images/、tool/）。粒子工坊放在 粒子库/ 里面时是 ../..
PARTICLE_LIBRARY_DIR=../..

# 大模型（OpenAI 兼容；默认 DeepSeek）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# deepseek-flash 即 DeepSeek-V4.1-Flash-1017
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=300
# 思考模式 enabled / disabled；留空不发该参数（非 DeepSeek 接口用）
LLM_THINKING=enabled
# 思考强度 low / high / max
LLM_REASONING_EFFORT=high
# 思考开启时，在各尺寸输出上限之外额外给的 token（思考也计入 max_tokens）
LLM_THINKING_TOKEN_BUDGET=16000

# 功能一
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_DEFAULT_VARIANTS=2

# 功能二
EXTRACT_MAX_SIDE_PX=512
EXTRACT_MAX_UPLOAD_MB=10
